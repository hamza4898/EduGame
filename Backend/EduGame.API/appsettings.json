{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MyAppSettings": {
    "ApplicationName": "EduGame",
    "Version": "1.0.0",
    "DefaultPageSize": 20
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=edugamedb;Username=postgres"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "System": "Error"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "EduGame",
      "Server": "Server-localhost"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] [{Application}/{Server}] [ID: {CorrelationId}] {Message:lj}{NewLine}{Exception}"
              }
            },
            {
              "Name": "File",
              "Args": {
                "path": "Logs/EduGame-.txt",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 7,
                "fileSizeLimitBytes": 10485760,
                "rollOnFileSizeLimit": true,
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level:u3}] [{Application}/{Server}] [ID: {CorrelationId}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ]
  },
  "EmailSettings": {
    "DefaultFromEmail": "support@edugame.com",
    "DefaultFromName": "EduGame Support",
    "SmtpServer": "localhost",
    "SmtpPort": 1025
  },
  "Authentication": {
    "Google": {
      "ClientId": "19946886621-hfvjnrv80pi4qm9811sj3s5dfacdvt5a.apps.googleusercontent.com",
      "ClientSecret": ""
    }
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "qwen2.5-coder:1.5b"
  }
}